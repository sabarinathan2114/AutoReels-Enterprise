# AutoReels Enterprise v2.0 - Environment Configuration
APP_NAME="AutoReels Enterprise"
APP_VERSION="2.0.0"
ENV="development"
DEBUG=true
PORT=8000

# Database Configuration (MySQL 8.0+ / MariaDB)
DATABASE_URL="mysql+pymysql://root:@127.0.0.1:3306/autoreels_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# Redis & Celery/Arq Queue
REDIS_URL="redis://127.0.0.1:6379/0"

# Storage Backend (local | s3 | minio)
STORAGE_BACKEND="local"
MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="autoreels-assets"

# Security & Tokens
JWT_SECRET="autoreels_enterprise_super_secret_jwt_key_2026_change_in_prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# Email / Mailpit
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_FROM_EMAIL="noreply@autoreels.local"
